# Copy this file to .env and fill in the values before starting the stack.
# In Portainer: paste these keys into the "Environment variables" section when creating the stack.

# Bcrypt hash of the password to access the app.
# Generate one with: python -c "import bcrypt; print(bcrypt.hashpw(b'yourpassword', bcrypt.gensalt()).decode())"
# IMPORTANT: escape every $ in the hash with $$ so Docker Compose does not treat them as variable references.
# Example: $2b$12$abc... becomes $$2b$$12$$abc...
APP_PASSWORD=$$2b$$12$$changeme_replace_with_real_hash

# Host port the app is exposed on (default: 5000)
PORT=5000

# Optional: route all yt-dlp traffic through a proxy located in a country where the content is available.
# Examples: http://user:pass@host:8080  or  socks5://host:1080
YTDLP_PROXY=

# Optional: path INSIDE the container to a Netscape cookies.txt from a logged-in YouTube account.
# Required for private YouTube playlists. Mount the file with the volume in docker-compose.yml.
YTDLP_COOKIES=
